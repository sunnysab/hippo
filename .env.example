# Core database connection required by both `hippo serve` and `hippo sync-worker`.
# The account needs pg_jieba and pg_trgm; `python -m hippo db init` creates them.
HIPPO_PG_DSN=postgresql://postgres@127.0.0.1:5432/mp

# ---- weixin-rs daemon ----------------------------------------------------
# hippo talks to the daemon over RPC; the wechat session lives there, not here.
# WEIXIN_SDK_PATH=/opt/weixin-rs/sdk/python
# WEIXIN_DAEMON_HOST=127.0.0.1
# WEIXIN_DAEMON_PORT=9099

# ---- Runtime tuning ------------------------------------------------------
HIPPO_LOG_LEVEL=WARNING
# HIPPO_PG_JIEBA_WARMUP=1
# HIPPO_PG_JIEBA_WARMUP_TEXT=hippo
# HIPPO_PG_POOL_MIN=1
# HIPPO_PG_POOL_MAX=8
# HIPPO_PG_DISABLE_JIT=1
# Proxy used when fetching article pages and avatars.
# HIPPO_HTTP_PROXY=
# Sync inside the web process (development only; production runs `hippo sync-worker`).
# HIPPO_ENABLE_INPROCESS_SYNC=0
# Sessions: Secure must stay off when serving plain HTTP.
# HIPPO_COOKIE_SECURE=1
# HIPPO_SESSION_TTL_HOURS=168

# Optional article HTML relay (Cloudflare Worker).
# HIPPO_ARTICLE_WORKER=
# HIPPO_ARTICLE_WORKER_PROXY=
# HIPPO_ARTICLE_MAX_CONNECTIONS=2

# Optional object storage for article images (path-style addressing).
# HIPPO_S3_ENDPOINT=
# HIPPO_S3_BUCKET=
# HIPPO_S3_ACCESS_KEY=
# HIPPO_S3_SECRET_KEY=
# HIPPO_S3_REGION=
# HIPPO_S3_PREFIX=

# ---- Observability -------------------------------------------------------
# OTLP endpoint for traces / metrics / logs (SignOz). Telemetry stays off
# unless an endpoint is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://archlinux30:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# HIPPO_OTEL_ENABLED=1
# HIPPO_OTEL_SAMPLE_RATIO=0.1
# HIPPO_ENV=prod
# Target of the admin console's "open in SignOz" link.
# HIPPO_SIGNOZ_URL=

# Structured logging: json (default) or console. JSON is what SignOz ingests.
# HIPPO_LOG_FORMAT=json
# File log (also read by `GET /api/admin/log/tail`).
# HIPPO_LOG_FILE=
# HIPPO_LOG_TAIL_LINES=500
